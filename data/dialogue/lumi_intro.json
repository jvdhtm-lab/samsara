		"first_meeting": {
			"lines": [
				{ "text": "Oh! Your lights are on again. I was starting to worry.", "expression": "happy" },
				"The sky has been humming all morning. Can you hear it too?"
			],
			"choices": [
				{
					"text": "I hear it too. Are you alright?",
					"next": "reassure",
					"effects": [
						{ "type": "relationship", "character": "lumi", "attr": "trust", "delta": 1 },
						{ "type": "flag", "flag": "heard_humming", "value": true },
						{ "type": "quest", "quest": "lumi_story", "action": "start" },
						{ "type": "quest", "quest": "lumi_story", "action": "objective", "objective": "listen_with_lumi" }
					]
				},
				{
					"text": "You are imagining things.",
					"next": "dismiss",
