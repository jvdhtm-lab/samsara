		"final_reassure": {
			"lines": [
				{ "text": "There is a plaque by the old tree. Would you read it, and tell me what it says?", "expression": "happy" }
			],
			"choices": []
		},
		"dismiss": {
			"lines": [
				{ "text": "...Maybe.", "expression": "sad" },
				"I hope you are right. I really do."
